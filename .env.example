# ── Panda Bear Agent — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── BambooHR ─────────────────────────────────────────────────────────────────
BAMBOO_API_KEY=your_bamboohr_api_key_here
BAMBOO_SUBDOMAIN=koronet

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_APP_TOKEN=xapp-your-slack-app-token-here

# ── Groq AI ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Dashboard Auth ────────────────────────────────────────────────────────────
DASHBOARD_USER=junior@koronet.com
DASHBOARD_PASSWORD=koronet2024

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Personal Assistant (only this Slack user ID can use calendar/email skills) ──
JUNIOR_SLACK_ID=U0XXXXXXXXX

# ── Google OAuth — Calendar + Gmail + Docs + Slides (see setup_google_auth.py) ──
GOOGLE_CREDENTIALS_PATH=google_credentials.json
GOOGLE_TOKEN_PATH=google_token.json

# ── Slack channel for welcome announcements (must match a real channel name) ───
BIENVENIDAS_CHANNEL=koronet

# ── Fathom webhook (meeting notes) — see developers.fathom.ai ──────────────────
FATHOM_WEBHOOK_SECRET=

# ── Agent joins meetings on command (see setup_meeting_bot_auth.py) ────────────
MEETING_BOT_PROFILE_DIR=meeting_bot_profile
MEETING_BOT_MAX_DURATION_MINUTES=180
MEETING_RECORDINGS_DIR=meeting_recordings

# ── Recordatorios de aprobaciones pendientes (DM del bot a JUNIOR_SLACK_ID) ─────
REMINDER_FIRST_BUSINESS_DAYS=5
REMINDER_DAILY_HOUR=8
REMINDER_URGENT_BUSINESS_DAYS=1
REMINDER_TIMEZONE=America/Bogota
REMINDER_WEEKENDS=false
DASHBOARD_URL=http://localhost:8000/
# Canal de bienvenidas (#koronet) — id usado como destino del borrador
BIENVENIDAS_CHANNEL_ID=CDTF8BJP4
# Protege /cron/tick (cron externo que despierta el servicio en Render)
CRON_SECRET=
# Claude Code CLI que crea los borradores de Slack (services/slack_draft_worker.py)
CLAUDE_BIN=
SLACK_DRAFT_MODEL=sonnet
